{
  "name": "open-mqtt-bridges-website",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1 --port 4173",
    "build": "nuxt generate",
    "preview": "python3 -m http.server 4173 --directory .output/public",
    "postinstall": "nuxt prepare",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "nuxt typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mqtt-bridges/open-mqtt-bridges.github.io.git"
  },
  "homepage": "https://open-mqtt-bridges.github.io/",
  "bugs": {
    "url": "https://github.com/open-mqtt-bridges/open-mqtt-bridges.github.io/issues"
  },
  "version": "0.1.0",
  "packageManager": "pnpm@11.28.9",
  "dependencies": {
    "@iconify-json/lucide": "^1.2.152",
    "@nuxt/ui": "4.12.0",
    "nuxt": "4.6.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
  }
}
