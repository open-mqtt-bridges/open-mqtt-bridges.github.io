{
  "name": "open-mqtt-bridges",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "dev": "pnpm --dir apps/website dev",
    "build": "pnpm --dir apps/website build && npm --prefix docs run build && node scripts/assemble-guides.mjs",
    "preview": "python3 scripts/preview.py",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "pnpm --dir apps/website typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "node scripts/check.mjs",
    "test": "node --test \"test/**/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/open-mqtt-bridges/open-mqtt-bridges.github.io.git"
  },
  "homepage": "https://open-mqtt-bridges.github.io/",
  "bugs": {
    "url": "https://github.com/open-mqtt-bridges/open-mqtt-bridges.github.io/issues"
  },
  "packageManager": "pnpm@11.28.9",
  "devDependencies": {
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "prettier": "^3.10.1"
  }
}
